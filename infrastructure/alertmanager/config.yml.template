global:
  resolve_timeout: 5m

route:
  group_by: ['alertname', 'job']
  group_wait: 10s
  group_interval: 10s
  repeat_interval: 12h
  receiver: 'console-logger'

receivers:
  - name: 'console-logger'
    email_configs:
      - to: '${ALERT_EMAIL_TO}'
        from: '${GMAIL_FROM}'
        smarthost: 'smtp.gmail.com:587'
        auth_username: '${GMAIL_FROM}'
        auth_password: '${GMAIL_APP_PASSWORD}'
        require_tls: true
        headers:
          Subject: '🚨 [{{ .Status | toUpper }}] {{ .GroupLabels.alertname }}'
        html: |
          <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
            <div style="background: {{ if eq .Status "firing" }}#dc3545{{ else }}#28a745{{ end }}; color: white; padding: 15px; border-radius: 8px 8px 0 0;">
              <h2 style="margin: 0;">🚨 {{ .Status | toUpper }}: {{ .GroupLabels.alertname }}</h2>
            </div>
            <div style="border: 1px solid #ddd; padding: 20px; border-radius: 0 0 8px 8px;">
              {{ range .Alerts }}
              <table style="width: 100%; border-collapse: collapse; margin-bottom: 15px;">
                <tr><td style="padding: 8px; font-weight: bold; width: 130px;">Severity:</td><td style="padding: 8px;">{{ .Labels.severity }}</td></tr>
                <tr><td style="padding: 8px; font-weight: bold;">Service:</td><td style="padding: 8px;">{{ .Labels.job }}</td></tr>
                <tr><td style="padding: 8px; font-weight: bold;">Instance:</td><td style="padding: 8px;">{{ .Labels.instance }}</td></tr>
                <tr><td style="padding: 8px; font-weight: bold;">Summary:</td><td style="padding: 8px;">{{ .Annotations.summary }}</td></tr>
                <tr><td style="padding: 8px; font-weight: bold;">Description:</td><td style="padding: 8px;">{{ .Annotations.description }}</td></tr>
                <tr><td style="padding: 8px; font-weight: bold;">Started At:</td><td style="padding: 8px;">{{ .StartsAt.Format "2006-01-02 15:04:05 UTC" }}</td></tr>
                {{ if .EndsAt }}<tr><td style="padding: 8px; font-weight: bold;">Ended At:</td><td style="padding: 8px;">{{ .EndsAt.Format "2006-01-02 15:04:05 UTC" }}</td></tr>{{ end }}
              </table>
              <hr style="border: 1px solid #eee;">
              {{ end }}
              <p style="color: #666; font-size: 12px; margin-top: 15px;">
                📊 <a href="https://grafana.nadeem-dev.in">Grafana Dashboard</a> |
                🔍 <a href="https://prometheus.nadeem-dev.in/alerts">Prometheus Alerts</a> |
                🔔 <a href="https://alerts.nadeem-dev.in">Alertmanager</a>
              </p>
            </div>
          </div>

inhibit_rules:
  - source_match:
      severity: 'critical'
    target_match:
      severity: 'warning'
    equal: ['alertname', 'job']
